{
  "openapi": "3.1.0",
  "info": {
    "title": "MGL ERP Engineering Lab API",
    "version": "1.1.0",
    "description": "Interview-only local demo API. X-Demo-User is a fake identity switch, NOT production authentication. Some Change Request endpoints intentionally return 501."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:3333",
      "description": "Loopback assessment server only"
    }
  ],
  "tags": [
    {
      "name": "System"
    },
    {
      "name": "ERP"
    },
    {
      "name": "Change Requests"
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Local SQLite readiness and API version",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "tags": [
          "ERP"
        ],
        "summary": "Current synthetic identity and all demo identities",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/DemoUser"
          }
        ]
      }
    },
    "/api/projects": {
      "get": {
        "tags": [
          "ERP"
        ],
        "summary": "Projects visible to current demo identity",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/DemoUser"
          }
        ]
      }
    },
    "/api/tasks": {
      "get": {
        "tags": [
          "ERP"
        ],
        "summary": "Tasks visible to current demo identity",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/DemoUser"
          }
        ]
      },
      "post": {
        "tags": [
          "ERP"
        ],
        "summary": "Create task in accessible project",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/DemoUser"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TaskInput"
              }
            }
          }
        }
      }
    },
    "/api/tasks/{id}/status": {
      "patch": {
        "tags": [
          "ERP"
        ],
        "summary": "Change task status with expectedVersion",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/DemoUser"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/StatusChange"
              }
            }
          }
        }
      }
    },
    "/api/projects/{id}/health": {
      "get": {
        "tags": [
          "ERP"
        ],
        "summary": "Project completion and overdue counters",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/DemoUser"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/projects/{id}/activity": {
      "get": {
        "tags": [
          "ERP"
        ],
        "summary": "Project-scoped audit history",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/DemoUser"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/change-requests": {
      "get": {
        "tags": [
          "Change Requests"
        ],
        "summary": "List project-scoped change requests",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/DemoUser"
          },
          {
            "name": "projectId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "description": "Candidate implementation task; original starter returns HTTP 501 until implemented."
      },
      "post": {
        "tags": [
          "Change Requests"
        ],
        "summary": "Create a construction change request",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/DemoUser"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateChangeRequest"
              }
            }
          }
        },
        "description": "Candidate implementation task; original starter returns HTTP 501 until implemented."
      }
    },
    "/api/change-requests/{id}/decision": {
      "post": {
        "tags": [
          "Change Requests"
        ],
        "summary": "Approve or reject request with atomic audit",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/DemoUser"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Decision"
              }
            }
          }
        },
        "description": "Candidate implementation task; original starter returns HTTP 501 until implemented."
      }
    },
    "/api/change-requests/{id}/history": {
      "get": {
        "tags": [
          "Change Requests"
        ],
        "summary": "Audit events for specific change request",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "$ref": "#/components/parameters/DemoUser"
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "description": "Candidate implementation task; original starter returns HTTP 501 until implemented."
      }
    }
  },
  "components": {
    "parameters": {
      "DemoUser": {
        "name": "X-Demo-User",
        "in": "header",
        "required": false,
        "description": "Local mock user; e.g. u_pm, u_eng, u_view, u_out",
        "schema": {
          "type": "string"
        }
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          },
          "requestId": {
            "type": "string"
          }
        }
      },
      "TaskInput": {
        "type": "object",
        "required": [
          "projectId",
          "title",
          "priority",
          "dueDate"
        ],
        "properties": {
          "projectId": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 150
          },
          "priority": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          },
          "dueDate": {
            "type": "string",
            "format": "date"
          },
          "assignedTo": {
            "type": "string"
          }
        }
      },
      "StatusChange": {
        "type": "object",
        "required": [
          "status",
          "expectedVersion"
        ],
        "properties": {
          "status": {
            "type": "string",
            "enum": [
              "todo",
              "in_progress",
              "done"
            ]
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          }
        }
      },
      "CreateChangeRequest": {
        "type": "object",
        "required": [
          "projectId",
          "title",
          "description"
        ],
        "properties": {
          "projectId": {
            "type": "string"
          },
          "title": {
            "type": "string",
            "minLength": 3,
            "maxLength": 150
          },
          "description": {
            "type": "string",
            "minLength": 10,
            "maxLength": 2000
          }
        }
      },
      "Decision": {
        "type": "object",
        "required": [
          "action",
          "expectedVersion",
          "note"
        ],
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "approve",
              "reject"
            ]
          },
          "expectedVersion": {
            "type": "integer",
            "minimum": 1
          },
          "note": {
            "type": "string"
          }
        }
      }
    }
  }
}
