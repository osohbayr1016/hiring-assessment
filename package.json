{
  "name": "mgl-erp-engineering-lab",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "Dependency-free local ERP engineering interview lab; deliberately contains assessment defects",
  "engines": {
    "node": ">=22.13.0 <27"
  },
  "scripts": {
    "setup": "node tools/setup.mjs",
    "dev": "node src/server.mjs",
    "dev:watch": "node --watch src/server.mjs",
    "test": "node --test tests/*.test.mjs",
    "check:syntax": "node tools/check-syntax.mjs",
    "check": "npm run check:syntax && npm test",
    "smoke": "node tools/smoke.mjs",
    "verify": "npm run check && npm run smoke",
    "reset": "node tools/setup.mjs --reset"
  }
}
